# AI Interview Coach - Environment Configuration
PROJECT_NAME="AI Interview Coach"
ENV="development"
PORT=8000

# Database
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="ai_interview_coach"

# Security
JWT_SECRET="super-secret-jwt-key-change-in-production-ai-interview-coach"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=4096

# Model & Real-time Settings (CPU Optimized)
WHISPER_MODEL="tiny.en"
WHISPER_COMPUTE_TYPE="int8"
FRAME_SAMPLE_FPS=5
VIDEO_TTL_MINUTES=60
TEMP_DIR="./temp/interviews"

# CORS Settings
FRONTEND_URL="http://localhost:5173"
